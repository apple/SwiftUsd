   --build-args=\"USD,\\\"-DCMAKE_CXX_FLAGS_INIT=-ffile-prefix-map=$(realpath .)=OpenUSD\\\"\""],"syntax":"zsh","type":"codeListing"},{"style":"note","name":"Note","content":[{"inlineContent":[{"text":"Custom feature flags are experimental, and may have some restrictions. For example, building with Python will not work on Apple platforms, building with additional plugins may not work for app-bundlable packages, and packaging multiple Usd builds with incompatible feature flags may not work.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"items":[{"content":[{"inlineContent":[{"text":"Run ","type":"text"},{"type":"codeVoice","code":"scripts\/make-swift-package.zsh"},{"text":". Use the ","type":"text"},{"type":"codeVoice","code":"--generated-package-dir"},{"text":" flag to create the custom SwiftUsd package at a specific location (defaults to the SwiftUsd repo cloned from git). Note: if making the swift package in place with the following command, remove ","type":"text"},{"type":"codeVoice","code":"swift-package"},{"text":" before running ","type":"text"},{"type":"codeVoice","code":"make-swift-package"},{"text":".","type":"text"}],"type":"paragraph"}]}],"start":5,"type":"orderedList"},{"code":["cd ~\/SwiftUsd",".\/scripts\/make-swift-package.zsh openusd-builds\/*"],"syntax":"zsh","type":"codeListing"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WritingAndUsingOpenUSDPlugins","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/SwiftSubclassCxx","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DetectingOpenUSDFeatureFlags","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ChangesToOpenUSD"],"generated":true,"title":"Technical details","anchor":"Technical-details"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftusd\/buildinglocally"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/swiftusd\/buildinglocally"]}],"abstract":[{"type":"text","text":"Learn how to use SwiftUsd