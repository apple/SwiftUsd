d package at a specific location (defaults to the SwiftUsd repo cloned from git). Note: if making the swift package in place with the following command, remove "},{"type":"codeVoice","code":"swift-package"},{"type":"text","text":" before running "},{"type":"codeVoice","code":"make-swift-package"},{"type":"text","text":"."}]}]}],"start":5},{"type":"codeListing","code":["cd ~\/SwiftUsd",".\/scripts\/make-swift-package.zsh openusd-builds\/*"],"syntax":"zsh"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/BuildingLocally"},"variants":[{"paths":["\/documentation\/swiftusd\/buildinglocally"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/swiftusd\/buildinglocally"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftUsd\/documentation\/OpenUSD"]]},"kind":"article","abstract":[{"type":"text","text":"Learn how to use SwiftUsd with local\/existing OpenUSD binaries"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DetectingOpenUSDFeatureFlags","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ChangesToOpenUSD"],"title":"Technical details","anchor":"Technical-details","generated":true}],"metadata":{"roleHeading":"Article","role":"article","title":"Building locally","modules":[{"name":"OpenUSD"}]},"references":{"doc://SwiftUsd/documentation/SwiftUsd/GettingStarted":{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/GettingStarted","role":"article","kind":"article","abstract":[{"text":"Adding SwiftUsd to your project or package","type":"text"}],"type":"topic","url":"\/documentation\/swiftusd\/gettingstarted","title":"Getting Started with OpenUSD"},"doc://SwiftUsd/documentation/SwiftUsd/ChangesToOpenUSD":{"role":"article","abstract":[{"text":"Learn about the changes this Swift Package makes to OpenUSD","type":"text"}],"kind":"article","title":"Changes to OpenUSD","url":"\/documentation\/swif