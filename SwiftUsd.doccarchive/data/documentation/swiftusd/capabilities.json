{"identifier":{"url":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/Capabilities","interfaceLanguage":"swift"},"sections":[],"metadata":{"title":"Capabilities","roleHeading":"Article","role":"article","modules":[{"name":"OpenUSD"}]},"abstract":[{"text":"Learn about the current capabilities of OpenUSD in Swift","type":"text"}],"kind":"article","variants":[{"paths":["\/documentation\/swiftusd\/capabilities"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/swiftusd\/capabilities"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/GettingStarted","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DifferencesInSwift","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/CurrentLimitations"],"anchor":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"OpenUSD in Swift is currently evolving and may change in the future. Here are some key features currently supported:","type":"text"}]},{"text":"Reference types in Swift","type":"heading","anchor":"Reference-types-in-Swift","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"UsdStage and SdfLayer are imported as classes in Swift and behave like classes written in Swift. When Swift passes a raw pointer to UsdStage or SdfLayer, Swift automatically increments or decrements the underlying reference count as needed, allowing Swift or C++ to influence the lifetime of the same UsdStage or SdfLayer."}]},{"syntax":"swift","type":"codeListing","code":["func makeTempStage() -> pxr.UsdStage {","    return Overlay.Dereference(pxr.UsdStage.CreateNew(\"\/tmp\/myStage.usda\", .LoadAll))","}","","func defineXform(_ stage: pxr.UsdStage, _ path: pxr.SdfPath) {","    stage.DefinePrim(path, .UsdGeomTokens.Xform)","}","","let stage = makeTempStage()","defineXform(stage, \"\/hello\")","let layer = Overlay.Dereference(stage.GetRootLayer())","layer.Save(false)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WhatIsAForeignReferenceType"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ForeignReferenceTypesAndSmartPointers"},{"type":"text","text":" for more information."}]},{"name":"Warning","style":"warning","type":"aside","content":[{"inlineContent":[{"type":"text","text":"When working in Swift, do not use "},{"code":"TfRefPtr.pointee","type":"codeVoice"},{"type":"text","text":" or "},{"code":"TfWeakPtr.pointee","type":"codeVoice"},{"type":"text","text":" to dereference Pixar’s smart pointers, as the "},{"code":"pointee","type":"codeVoice"},{"type":"text","text":" property is unsafe. Use "},{"code":"Overlay.Dereference(_:TfRefPtr)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Overlay.Dereference(_:TfWeakPtr)","type":"codeVoice"},{"type":"text","text":" instead."}],"type":"paragraph"}]},{"text":"Swift protocol conformances","type":"heading","anchor":"Swift-protocol-conformances","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Many OpenUSD types conform to one or more of the following protocols:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Equatable"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Hashable"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Identifiable"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CustomStringConvertible"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ExpressibleByStringLiteral"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ExpressibleByArrayLiteral"}],"ty