{"metadata":{"role":"article","modules":[{"name":"OpenUSD"}],"roleHeading":"Article","title":"Capabilities"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftUsd\/documentation\/OpenUSD"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/Capabilities"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","abstract":[{"type":"text","text":"Learn about the current capabilities of OpenUSD in Swift"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/GettingStarted","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DifferencesInSwift","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/CurrentLimitations"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenUSD in Swift is currently evolving and may change in the future. Here are some key features currently supported:"}]},{"level":3,"text":"Reference types in Swift","type":"heading","anchor":"Reference-types-in-Swift"},{"type":"paragraph","inlineContent":[{"text":"UsdStage and SdfLayer are imported as classes in Swift and behave like classes written in Swift. When Swift passes a raw pointer to UsdStage or SdfLayer, Swift automatically increments or decrements the underlying reference count as needed, allowing Swift or C++ to influence the lifetime of the same UsdStage or SdfLayer.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func makeTempStage() -> pxr.UsdStage {","    return Overlay.Dereference(pxr.UsdStage.CreateNew(\"\/tmp\/myStage.usda\", .LoadAll))","}","","func defineXform(_ stage: pxr.UsdStage, _ path: pxr.SdfPath) {","    stage.DefinePrim(path, .UsdGeomTokens.Xform)","}","","let stage = makeTempStage()","defineXform(stage, \"\/hello\")","let layer = Overlay.Dereference(stage.GetRootLayer())","layer.Save(false)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WhatIsAForeignReferenceType","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ForeignReferenceTypesAndSmartPointers","type":"reference","isActive":true},{"type":"text","text":" for more information."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When working in Swift, do not use ","type":"text"},{"code":"TfRefPtr.pointee","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"TfWeakPtr.pointee","type":"codeVoice"},{"text":" to dereference Pixar’s smart pointers, as the ","type":"text"},{"code":"pointee","type":"codeVoice"},{"text":" property is unsafe. Use ","type":"text"},{"code":"Overlay.Dereference(_:TfRefPtr)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Overlay.Dereference(_:TfWeakPtr)","type":"codeVoice"},{"text":" instead.","type":"text"}]}],"type":"aside","name":"Warning","style":"warning"},{"level":3,"text":"Swift protocol conformances","type":"heading","anchor":"Swift-protocol-conformances"},{"type":"paragraph","inlineContent":[{"text":"Many OpenUSD types conform to one or more of the following protocols:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Equatable"}]}]},{"content":[{"inlineContent":[{"code":"Hashable","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Identifiable"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CustomStringConvertible"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ExpressibleByStringLiteral","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"ExpressibleByArrayLiteral","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Sequence","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Sendable"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["let token: pxr.TfToken = \"my custom token\" \/\/ TfToken conforms to ExpressibleByStringLiteral","var prims: Set<pxr.UsdPrim> = Set<pxr.UsdPrim>() \/\/ UsdPrim conforms to Hashable","let numbers: pxr.VtIntArray = [1, 2, 3] \/\/ VtIntArray conforms to ExpressibleByArrayLiteral"]},{"anchor":"TfNotice-support","type":"heading","level":3,"text":"TfNotice support"},{"type":"paragraph","inlineContent":[{"text":"Swift code can register for ","type":"text"},{"code":"TfNotice","type":"codeVoice"},{"text":" callbacks by using ","type":"text"},{"overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register"}],"isActive":true,"overridingTitle":"pxr.TfNotice.Register","type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-70l8s"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class StageWatcher {","    var stage: pxr.UsdStage","    var key: pxr.TfNotice.SwiftKey","","    init(stage: pxr.UsdStage) {","        self.stage = stage","","        key = pxr.TfNotice.Register(stage, pxr.UsdNotice.ObjectsChanged.self) { notice in","            print(\"Resynced: \\(notice.GetResyncedPaths())\")","            print(\"Changed info only: \\(notice.GetChangedInfoOnlyPaths())\")","        }","    }","    deinit {","        pxr.TfNotice.Revoke(key)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information, see "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfNotice","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"anchor":"More-details","type":"heading","level":3,"text":"More details"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For details about supported features, see "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/Differe