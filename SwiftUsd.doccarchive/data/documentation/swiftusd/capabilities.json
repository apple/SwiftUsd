{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"OpenUSD in Swift is currently evolving and may change in the future. Here are some key features currently supported:","type":"text"}],"type":"paragraph"},{"text":"Reference types in Swift","level":3,"anchor":"Reference-types-in-Swift","type":"heading"},{"inlineContent":[{"text":"UsdStage and SdfLayer are imported as classes in Swift and behave like classes written in Swift. When Swift passes a raw pointer to UsdStage or SdfLayer, Swift automatically increments or decrements the underlying reference count as needed, allowing Swift or C++ to influence the lifetime of the same UsdStage or SdfLayer.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func makeTempStage() -> pxr.UsdStage {","    return Overlay.Dereference(pxr.UsdStage.CreateNew(\"\/tmp\/myStage.usda\", .LoadAll))","}","","func defineXform(_ stage: pxr.UsdStage, _ path: pxr.SdfPath) {","    stage.DefinePrim(path, .UsdGeomTokens.Xform)","}","","let stage = makeTempStage()","defineXform(stage, \"\/hello\")","let layer = Overlay.Dereference(stage.GetRootLayer())","layer.Save(false)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WhatIsAForeignReferenceType","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ForeignReferenceTypesAndSmartPointers","isActive":true},{"type":"text","text":" for more information."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"When working in Swift, do not use ","type":"text"},{"type":"codeVoice","code":"TfRefPtr.pointee"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"TfWeakPtr.pointee"},{"text":" to dereference Pixar’s smart pointers, as the ","type":"text"},{"type":"codeVoice","code":"pointee"},{"text":" property is unsafe. Use ","type":"text"},{"type":"codeVoice","code":"Overlay.Dereference(_:TfRefPtr)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Overlay.Dereference(_:TfWeakPtr)"},{"text":" instead.","type":"text"}]}],"name":"Warning","style":"warning","type":"aside"},{"text":"Swift protocol conformances","level":3,"anchor":"Swift-protocol-conformances","type":"heading"},{"inlineContent":[{"text":"Many OpenUSD types conform to one or more of the following protocols:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Equatable"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Hashable"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Identifiable"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CustomStringConvertible"}]}]},{"content":[{"inlineContent":[{"code":"ExpressibleByStringLiteral","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ExpressibleByArrayLiteral"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sequence"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["let token: pxr.TfToken = \"my custom token\" \/\/ TfToken conforms to ExpressibleByStringLiteral","var prims: Set<pxr.UsdPrim> = Set<pxr.UsdPrim>() \/\/ UsdPrim conforms to Hashable","let numbers: pxr.VtIntArray = [1, 2, 3] \/\/ VtIntArray conforms to ExpressibleByArrayLiteral"],"type":"codeListing"},{"text":"TfNotice support","level":3,"anchor":"TfNotice-support","type":"heading"},{"inlineContent":[{"type":"text","text":"Swift code can register for "},{"code":"TfNotice","type":"codeVoice"},{"type":"text","text":" callbacks by using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-1hdp4","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register"}],"overridingTitle":"pxr.TfNotice.Register"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["class StageWatcher {","    var stage: pxr.UsdStage","    var key: pxr.TfNotice.SwiftKey","","    init(stage: pxr.UsdStage) {","        self.stage = stage","","        key = pxr.TfNotice.Register(stage, pxr.UsdNotice.ObjectsChanged.self) { notice in","            print(\"Resynced: \\(notice.GetResyncedPaths())\")","            print(\"Changed info only: \\(notice.GetChangedInfoOnlyPaths())\")","        }","    }","    deinit {","        pxr.TfNotice.Revoke(key)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"For more information, see ","type":"text"},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfNotice","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"More details","level":3,"anchor":"More-details","type":"heading"},{"inlineContent":[{"type":"text","text":"For details about supported features, see "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DifferencesInSwift","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftUsd\/documentation\/OpenUSD"]]},"kind":"article","abstract":[{"type":"text","text":"Learn about the current capabilities of OpenUSD in Swift"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftusd\/capabilities"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/swiftusd\/capabilities"]}],"metadata":{"role":"article","modules":[{"name":"OpenUSD"}],"roleHeading":"Article","title":"Capabilities"},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/GettingStarted","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DifferencesInSwift","doc:\/\/Swi