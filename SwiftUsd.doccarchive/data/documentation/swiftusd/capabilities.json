{"identifier":{"url":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/Capabilities","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenUSD in Swift is currently evolving and may change in the future. Here are some key features currently supported:"}]},{"level":3,"type":"heading","text":"Reference types in Swift","anchor":"Reference-types-in-Swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"UsdStage and SdfLayer are imported as classes in Swift and behave like classes written in Swift. When Swift passes a raw pointer to UsdStage or SdfLayer, Swift automatically increments or decrements the underlying reference count as needed, allowing Swift or C++ to influence the lifetime of the same UsdStage or SdfLayer."}]},{"syntax":"swift","type":"codeListing","code":["func makeTempStage() -> pxr.UsdStage {","    return Overlay.Dereference(pxr.UsdStage.CreateNew(\"\/tmp\/myStage.usda\", .LoadAll))","}","","func defineXform(_ stage: pxr.UsdStage, _ path: pxr.SdfPath) {","    stage.DefinePrim(path, .UsdGeomTokens.Xform)","}","","let stage = makeTempStage()","defineXform(stage, \"\/hello\")","let layer = Overlay.Dereference(stage.GetRootLayer())","layer.Save(false)"]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WhatIsAForeignReferenceType","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ForeignReferenceTypesAndSmartPointers","isActive":true,"type":"reference"},{"text":" for more information.","type":"text"}]},{"style":"warning","type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When working in Swift, do not use "},{"type":"codeVoice","code":"TfRefPtr.pointee"},{"type":"text","text":" or "},{"type":"codeVoice","code":"TfWeakPtr.pointee"},{"type":"text","text":" to dereference Pixar’s smart pointers, as the "},{"type":"codeVoice","code":"pointee"},{"type":"text","text":" property is unsafe. Use "},{"type":"codeVoice","code":"Overlay.Dereference(_:TfRefPtr)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Overlay.Dereference(_:TfWeakPtr)"},{"type":"text","text":" instead."}]}]},{"level":3,"type":"heading","text":"Swift protocol conformances","anchor":"Swift-protocol-conformances"},{"type":"paragraph","inlineContent":[{"text":"Many OpenUSD types conform to one or more of the following protocols:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Equatable"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Hashable"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Identifiable"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CustomStringConvertible"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ExpressibleByStringLiteral"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ExpressibleByArrayLiteral","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Sequence","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"Sendable","type":"codeVoice"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["let token: pxr.TfToken = \"my custom token\" \/\/ TfToken conforms to ExpressibleByStringLiteral","var prims: Set<pxr.UsdPrim> = Set<pxr.UsdPrim>() \/\/ UsdPrim conforms to Hashable","let numbers: pxr.VtIntArray = [1, 2, 3] \/\/ VtIntArray conforms to ExpressibleByArrayLiteral"]},{"level":3,"type":"heading","text":"TfNotice support","anchor":"TfNotice-support"},{"type":"paragraph","inlineContent":[{"text":"Swift code can register for ","type":"text"},{"code":"TfNotice","type":"codeVoice"},{"text":" callbacks by using ","type":"text"},{"overridingTitle":"pxr.TfNotice.Register","isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-89t45","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register"}]},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["class StageWatcher {","    var stage: pxr.UsdStage","    var key: pxr.TfNotice.SwiftKey","","    init(stage: pxr.UsdStage) {","        self.stage = stage","","        key = pxr.TfNotice.Register(stage, pxr.UsdNotice.ObjectsChanged.self) { notice in","            print(\"Resynced: \\(notice.GetResyncedPaths())\")","            print(\"Changed info only: \\(notice.GetChangedInfoOnlyPaths())\")","        }","    }","    deinit {","        pxr.TfNotice.Revoke(key)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfNotice"},{"type":"text","text":"."}]},{"level":3,"type":"heading","text":"More details","anchor":"More-details"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For details about supported features, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DifferencesInSwift"},{"text":".","type":"text"}]}]}],"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/GettingStarted","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DifferencesInSwift","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/CurrentLimitations"]}],"variants":[{"paths":["\/documentation\/swiftusd\/capabilities"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/swiftusd\/capabilities"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata