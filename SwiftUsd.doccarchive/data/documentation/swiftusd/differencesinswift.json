rence","overridingTitle":"pxr.TfNotice.Register","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-1hdp4"},{"type":"text","text":" and pass a closure:"}],"type":"paragraph"},{"syntax":"swift","code":["func registerWithRevoking(stage: pxr.UsdStage) {","    let key = pxr.TfNotice.Register(stage, pxr.UsdNotice.StageContentsChanged.self) { _ in","        print(\"Stage contents changed\")","    }","","    stage.SetStartTimeCode(5) \/\/ prints \"Stage contents changed\"","    stage.SetEndTimeCode(7) \/\/ prints \"Stage contents changed\"","    pxr.TfNotice.Revoke(key)","    stage.SetTimeCodesPerSecond(60) \/\/ no print","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"For more information, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfNotice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"GfMatrix4d static factory methods","anchor":"GfMatrix4d-static-factory-methods","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"In C++, "},{"code":"pxr::GfMatrix4d().SetTranslate()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"pxr::GfMatrix4d().SetRotate()","type":"codeVoice"},{"type":"text","text":" are valid expressions, but mutated method chaining on function return values is not supported in Swift."},{"type":"text","text":"\n"},{"type":"text","text":"This Swift Package provides "},{"overridingTitle":"pxr.GfMatrix4d.MakeTranslate()","type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.GfMatrix4d.MakeTranslate()"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/GfMatrix4d\/MakeTranslate(_:)"},{"type":"text","text":" and "},{"overridingTitle":"pxr.GfMatrix4d.MakeRotate()","type":"reference","isActive":true,"overridingTitleInlineContent":[{"code":"pxr.GfMatrix4d.MakeRotate()","type":"codeVoice"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C