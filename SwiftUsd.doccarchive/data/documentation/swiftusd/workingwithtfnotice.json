e":"pxr.TfNotice.Register()"},{"type":"text","text":" that provide the "},{"type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"codeVoice","code":"NoticeCaster"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/NoticeCaster","overridingTitle":"NoticeCaster"},{"type":"text","text":" as a parameter to the notification callback:"}],"type":"paragraph"},{"code":["func registerWithDowncasting() {","    pxr.TfNotice.Register(pxr.UsdNotice.StageNotice.self) { notice, caster in","        if let layerMutingChanged = caster(pxr.UsdNotice.LayerMutingChanged.self) {","            print(\"Muted: \\(layerMutingChanged.GetMutedLayers())\")","            print(\"Unmuted: \\(layerMutingChanged.GetUnmutedLayers())\")","        } else if let stageEditTargetChanged = caster(pxr.UsdNotice.StageEditTargetChanged.self) {","            print(\"Stage edit target changed: \\(stageEditTargetChanged.GetStage())\")","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Cancellation","level":2,"text":"Cancellation","type":"heading"},{"inlineContent":[{"text":"To cancel a notification callback, pass the return value from ","type":"text"},{"isActive":true,"overridingTitle":"pxr.TfNotice.Register","type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-28red","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register"}]},{"text":" to ","type":"text"},{"isActive":true,"overridingTitle":"pxr.TfNotice.Revoke","type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/Revoke-31sr0","overridingTitleInlineContent":[{"code":"pxr.TfNotice.Revoke","type":"codeVoice"}]},{"text":":","type":"text"}],"type":"paragraph"},{"code":["func registerWithRevoking(stage: pxr.UsdStage) {","    let key = pxr.TfNotice.Register(stage, pxr.UsdNotice.StageContentsChanged.self) { _ in","        print(\"Stage contents changed\")","    }","","    stage.SetStartTimeCode(5) \/\/ prints \"Stage contents changed\"","    stage.SetEndTimeCode(7) \/\/ prints \"Stage contents changed\"","    pxr.TfNotice.Revoke(key)","    stage.SetTimeCodesPerSecond(60) \/\/ no print","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Swift-Cxx-interoperability","level":2,"text":"Swift-Cxx interoperability","type":"heading"},{"inlineContent":[{"type":"text","text":"The C++ and Swift versions of "},{"type":"reference","overridingTitle":"pxr::TfNotice","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice","isActive":true,"overridingTitleInlineContent":[{"code":"pxr::TfNotice","type":"codeVoice"}]},{"type":"text","text":" can interoperate with each other. The C++ return type "},{"type":"reference","overridingTitle":"pxr::TfNotice::Key","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Key","isActive":true,"overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr::TfNotice::Key"}]},{"type":"text","text":" can be converted into the Swift return type "},{"type":"reference","overridingTitle":"pxr::TfNotice::SwiftKey","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/SwiftKey","isActive":true,"overridingTitleInlineContent":[{"code":"pxr::TfNotice::SwiftKey","type":"codeVoice"}]},{"type":"text","text":", and both return types can be revoked from either language."}],"type":"paragraph"},{"code":["pxr::TfNotice::Key registerForChanges(pxr::UsdStageWeakPtr);"],"syntax":"c++","type":"codeListing"},{"code":["class KeyHolder {","    var keys = pxr.TfNotice.SwiftKeys()","","    init() {}","","    func callCppRegisterForChanges(stage: pxr.UsdStageWeakPtr) {","        let cppKey = registerForChanges(stage)","        let swiftKey = pxr.TfNotice.SwiftKey(cppKey)","        keys.push_back(swiftKey)","    }","","    func revokeAll() {","        pxr.TfNotice.Revoke(&keys)","    }","}"],"syntax":"swift","type":"codeListing"}]}],"seeAlsoSections":[{"anchor":"New-symbol-documentation","generated":true,"identifiers":["