{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"OpenUSD includes a notification subsystem based on "},{"type":"codeVoice","code":"pxr::TfNotice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"pxr::TfNotice::Register"},{"type":"text","text":" for use in C++. SwiftUsd exposes this system to Swift with minor modifications."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Like in C++, TfNotice registration in Swift comes in three main forms:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","overridingTitle":"pxr.TfNotice.Register(_:_:)","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-70l8s","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register(_:_:)"}],"isActive":true},{"text":" to register for a particular notice type, regardless of sender","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","overridingTitle":"pxr.TfNotice.Register(_:_:_:)","overridingTitleInlineContent":[{"code":"pxr.TfNotice.Register(_:_:_:)","type":"codeVoice"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:_:)-5a155"},{"type":"text","text":" to register for a particular notice type from a specific sender, without retrieving the sender in the notification callback"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:_:)-6y96j","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register(_:_:_:)"}],"overridingTitle":"pxr.TfNotice.Register(_:_:_:)"},{"type":"text","text":" to register for a particular notice type from a specific sender while retrieving the sender in the notification callback"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Example usage:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class StageWatcher {","    var stage: pxr.UsdStage","    var key: pxr.TfNotice.SwiftKey","","    init(stage: pxr.UsdStage) {","        self.stage = stage","","        key = pxr.TfNotice.Register(stage, pxr.UsdNotice.ObjectsChanged.self) { notice in","            print(\"Resynced: \\(notice.GetResyncedPaths())\")","            print(\"Changed info only: \\(notice.GetChangedInfoOnlyPaths())\")","        }","    }","    deinit {","        pxr.TfNotice.Revoke(key)","    }","}"],"type":"codeListing"},{"text":"Downcasting and inheritance","level":2,"anchor":"Downcasting-and-inheritance","type":"heading"},{"inlineContent":[{"type":"text","text":"When registering for a notice type, your notification callback may be called if notices that derive from the notice type you registered for are sent. To support conditional casting of "},{"code":"TfNotice","type":"codeVoice"},{"type":"text","text":" values in the notification callback, SwiftUsd provides "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/NoticeCaster","type":"reference","isActive":true},{"type":"text","text":" and three auxillary forms of "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-70l8s","type":"reference","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register()"}],"isActive":true,"overridingTitle":"pxr.TfNotice.Register()"},{"type":"text","text":" that provide the "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/NoticeCaster","type":"reference","overridingTitleInlineContent":[{"code":"NoticeCaster","type":"codeVoice"}],"isActive":true,"overridingTitle":"NoticeCaster"},{"type":"text","text":" as a parameter to the notification callback:"}],"type":"paragraph"},{"syntax":"swift","code":["func registerWithDowncasting() {","    pxr.TfNotice.Register(pxr.UsdNotice.StageNotice.self) { notice, caster in","        if let layerMutingChanged = caster(pxr.UsdNotice.LayerMutingChanged.self) {","            print(\"Muted: \\(layerMutingChanged.GetMutedLayers())\")","            print(\"Unmuted: \\(layerMutingChanged.GetUnmutedLayers())\")","        } else if let stageEditTargetChanged = caster(pxr.UsdNotice.StageEditTargetChanged.self) {","            print(\"Stage edit target changed: \\(stageEditTargetChanged.GetStage())\")","        }","    }","}"],"type":"codeListing"},{"text":"Cancellation","level":2,"anchor":"Cancellation","type":"heading"},{"inlineContent":[{"text":"To cancel a notification callback, pass the return value from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-70l8s","type":"reference","overridingTitle":"pxr.TfNotice.Register","overridingTitleInlineContent":[{"code":"pxr.TfNotice.Register","type":"codeVoice"}]},{"text":" to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/Revoke-31sr0","type":"reference","overridingTitle":"pxr.TfNotice.Revoke","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Revoke"}]},{"text":":","type":"text"}],"type":"paragraph"},{"code":["func registerWithRevoking(stage: pxr.UsdStage) {","    let key = pxr.TfNotice.Register(stage, pxr.UsdNotice.StageContentsChanged.self) { _ in","        print(\"Stage contents changed\")","    }","","    stage.SetStartTimeCode(5) \/\/ prints \"Stage contents changed\"","    stage.SetEndTimeCode(7) \/\/ prints \"Stage contents changed\"","    pxr.TfNotice.Revoke(key)","    stage.SetTimeCodesPerSecond(60) \/\/ no print","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Swift-Cxx interoperability","anchor":"Swift-Cxx-interoperability","type":"heading"},{"inlineContent":[{"type":"text","text":"The C++ and Swift versions of "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice","isActive":true,"overridingTitle":"pxr::TfNotice","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr::TfNotice"}]},{"type":"text","text":" can interoperate with each other. The C++ return type "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Key","isActive":true,"overridingTitle":"pxr::TfNotice::Key","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr::TfNotice::Key"}]},{"type":"text","text":" can be converted into the Swift return type "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/SwiftKey","isActive":true,"overridingTitle":"pxr::TfNotice::SwiftKey","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr::TfNotice::SwiftKey"}]},{"type":"text","text":", and both return types can be revoked from either language."}],"type":"paragraph"},{"code":["pxr::TfNotice::Key registerForChanges(pxr::UsdStageWeakPtr);"],"syntax":"c++","type":"codeListing"},{"code":["class KeyHolder {","    var keys = pxr.TfNotice.SwiftKeys()","","    init() {}","","    func callCppRegisterForChanges(stage: pxr.UsdStageWeakPtr) {","        let cppKey = registerForChanges(stage)","        let swiftKey = pxr.TfNotice.SwiftKey(cppKey)","        keys.push_back(swiftKey)","    }","","    func revokeAll() {","        pxr.TfNotice.Revoke(&keys)","    }","}"],"syntax":"swift","type":"codeListing"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfNotice"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftUsd\/documentation\/OpenUSD"]]},"abstract":[{"type":"text","text":"Learn how to use the TfNotice notification subsystem in Swift"}],"metadata":{"role":"article","title":"Working with TfNotice","roleHeading":"Article","modules":[{"name":"OpenUSD"}]},"variants":[{"paths":["\/documentation\/swiftusd\/workingwithtfnotice"],"traits":[{"interfaceLanguage":"swi