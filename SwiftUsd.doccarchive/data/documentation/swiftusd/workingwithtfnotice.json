:"paragraph","inlineContent":[{"text":"When registering for a notice type, your notification callback may be called if notices that derive from the notice type you registered for are sent. To support conditional casting of ","type":"text"},{"type":"codeVoice","code":"TfNotice"},{"text":" values in the notification callback, SwiftUsd provides ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/NoticeCaster"},{"text":" and three auxillary forms of ","type":"text"},{"isActive":true,"type":"reference","overridingTitle":"pxr.TfNotice.Register()","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-1hdp4","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register()"}]},{"text":" that provide the ","type":"text"},{"isActive":true,"type":"reference","overridingTitle":"NoticeCaster","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/NoticeCaster","overridingTitleInlineContent":[{"type":"codeVoice","code":"NoticeCaster"}]},{"text":" as a parameter to the notification callback:","type":"text"}]},{"code":["func registerWithDowncasting() {","    pxr.TfNotice.Register(pxr.UsdNotice.StageNotice.self) { notice, caster in","        if let layerMutingChanged = caster(pxr.UsdNotice.LayerMutingChanged.self) {","            print(\"Muted: \\(layerMutingChanged.GetMutedLayers())\")","            print(\"Unmuted: \\(layerMutingChanged.GetUnmutedLayers())\")","        } else if let stageEditTargetChanged = caster(pxr.UsdNotice.StageEditTargetChanged.self) {","            print(\"Stage edit target changed: \\(stageEditTargetChanged.GetStage())\")","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Cancellation","type":"heading","level":2,"text":"Cancellation"},{"type":"paragraph","inlineContent":[{"text":"To cancel a notification callback, pass the return value from ","type":"text"},{"overridingTitle":"pxr.