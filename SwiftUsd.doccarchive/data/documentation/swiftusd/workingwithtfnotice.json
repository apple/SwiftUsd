e type you registered for are sent. To support conditional casting of "},{"type":"codeVoice","code":"TfNotice"},{"type":"text","text":" values in the notification callback, SwiftUsd provides "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/NoticeCaster","isActive":true},{"type":"text","text":" and three auxillary forms of "},{"type":"reference","overridingTitleInlineContent":[{"code":"pxr.TfNotice.Register()","type":"codeVoice"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-28red","isActive":true,"overridingTitle":"pxr.TfNotice.Register()"},{"type":"text","text":" that provide the "},{"type":"reference","overridingTitleInlineContent":[{"type":"codeVoice","code":"NoticeCaster"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/NoticeCaster","isActive":true,"overridingTitle":"NoticeCaster"},{"type":"text","text":" as a parameter to the notification callback:"}]},{"type":"codeListing","syntax":"swift","code":["func registerWithDowncasting() {","    pxr.TfNotice.Register(pxr.UsdNotice.StageNotice.self) { notice, caster in","        if let layerMutingChanged = caster(pxr.UsdNotice.LayerMutingChanged.self) {","            print(\"Muted: \\(layerMutingChanged.GetMutedLayers())\")","            print(\"Unmuted: \\(layerMutingChanged.GetUnmutedLayers())\")","        } else if let stageEditTargetChanged = caster(pxr.UsdNotice.StageEditTargetChanged.self) {","            print(\"Stage edit target changed: \\(stageEditTargetChanged.GetStage())\")","        }","    }","}"]},{"text":"Cancellation","type":"heading","anchor":"Cancellation","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To cancel a notification callback, pass the return value from "},{"overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-28red","overri