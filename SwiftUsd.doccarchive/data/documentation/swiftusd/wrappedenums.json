{"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most public enums in OpenUSD aren’t correctly imported due to a bug in Swift-Cxx interop: "},{"identifier":"https:\/\/github.com\/swiftlang\/swift\/issues\/62127","type":"reference","isActive":true},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"This Swift Package provides a workaround by migrating the enums to the "},{"type":"codeVoice","code":"Overlay"},{"type":"text","text":" namespace. For example,"}]},{"type":"codeListing","code":["let stage = Overlay.Dereference(pxr.UsdStage.CreateInMemory(pxr.UsdStage.LoadAll)) \/\/ error: can't find pxr.UsdStage.LoadAll","let stage = Overlay.Dereference(pxr.UsdStage.CreateInMemory(Overlay.UsdStage.LoadAll)) \/\/ success: finds Overlay.UsdStage.LoadAll"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, when Swift can infer the type of the enum, you can use implicit member expressions. For example,"}]},{"type":"codeListing","code":["let stage = Overlay.Dereference(pxr.UsdStage.CreateInMemory(.LoadAll)) \/\/ success: infers pxr.UsdStage.LoadAll"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftUsd\/documentation\/OpenUSD"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WrappedEnums"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Wrapped-symbol-documentation","identifiers":["doc:\/\/SwiftUsd\/documentation\/OpenUSD\/Overlay","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WrappedTypes","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WrappedFunctions","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WrappedOperators"],"title":"Wrapped symbol documentation"}],"metadata":{"role":"article","roleHeading":"Article","title":"Wrapped enums","modules":[{"name":"Ope