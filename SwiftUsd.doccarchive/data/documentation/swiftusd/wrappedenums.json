{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most public enums in OpenUSD aren’t correctly imported due to a bug in Swift-Cxx interop: "},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift\/issues\/62127","isActive":true},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"This Swift Package provides a workaround by migrating the enums to the "},{"type":"codeVoice","code":"Overlay"},{"type":"text","text":" namespace. For example,"}]},{"type":"codeListing","syntax":"swift","code":["let stage = Overlay.Dereference(pxr.UsdStage.CreateInMemory(pxr.UsdStage.LoadAll)) \/\/ error: can't find pxr.UsdStage.LoadAll","let stage = Overlay.Dereference(pxr.UsdStage.CreateInMemory(Overlay.UsdStage.LoadAll)) \/\/ success: finds Overlay.UsdStage.LoadAll"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, when Swift can infer the type of the enum, you can use implicit member expressions. For example,"}]},{"type":"codeListing","syntax":"swift","code":["let stage = Overlay.Dereference(pxr.UsdStage.CreateInMemory(.LoadAll)) \/\/ success: infers pxr.UsdStage.LoadAll"]}]}],"kind":"article","variants":[{"paths":["\/documentation\/swiftusd\/wrappedenums"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/swiftusd\/wrappedenums"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WrappedEnums","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"generated":true,"title":"Wrapped symbol documentation","anchor":"Wrapped-symbol-documentation","identifiers":["doc:\/\/SwiftUsd\/documentation\/OpenUSD\/Overlay","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WrappedTypes","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WrappedFunctions","doc:\/\/SwiftUsd\/documentation\