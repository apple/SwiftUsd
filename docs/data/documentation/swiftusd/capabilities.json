eference(stage.GetRootLayer())","layer.Save(false)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WhatIsAForeignReferenceType","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ForeignReferenceTypesAndSmartPointers","type":"reference","isActive":true},{"type":"text","text":" for more information."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"When working in Swift, do not use ","type":"text"},{"code":"TfRefPtr.pointee","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"TfWeakPtr.pointee","type":"codeVoice"},{"text":" to dereference Pixar’s smart pointers, as the ","type":"text"},{"code":"pointee","type":"codeVoice"},{"text":" property is unsafe. Use ","type":"text"},{"code":"Overlay.Dereference(_:TfRefPtr)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Overlay.Dereference(_:TfWeakPtr)","type":"codeVoice"},{"text":" instead.","type":"text"}],"type":"paragraph"}],"style":"warning","name":"Warning","type":"aside"},{"text":"Swift protocol conformances","level":3,"anchor":"Swift-protocol-conformances","type":"heading"},{"inlineContent":[{"text":"Many OpenUSD types conform to one or more of the following protocols:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"Equatable","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Hashable"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Identifiable"}]}]},{"content":[{"inlineContent":[{"code":"CustomStringConvertible","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ExpressibleByStringLiteral","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ExpressibleByArrayLiteral"}],"type":"paragraph"}]},{"content":[{"type":"par