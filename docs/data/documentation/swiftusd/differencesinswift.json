":"pxr.TfNotice.Register","type":"codeVoice"}],"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-1hdp4"},{"text":" and pass a closure:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func registerWithRevoking(stage: pxr.UsdStage) {","    let key = pxr.TfNotice.Register(stage, pxr.UsdNotice.StageContentsChanged.self) { _ in","        print(\"Stage contents changed\")","    }","","    stage.SetStartTimeCode(5) \/\/ prints \"Stage contents changed\"","    stage.SetEndTimeCode(7) \/\/ prints \"Stage contents changed\"","    pxr.TfNotice.Revoke(key)","    stage.SetTimeCodesPerSecond(60) \/\/ no print","}"]},{"inlineContent":[{"text":"For more information, see ","type":"text"},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfNotice","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"GfMatrix4d-static-factory-methods","type":"heading","text":"GfMatrix4d static factory methods"},{"inlineContent":[{"type":"text","text":"In C++, "},{"code":"pxr::GfMatrix4d().SetTranslate()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"pxr::GfMatrix4d().SetRotate()","type":"codeVoice"},{"type":"text","text":" are valid expressions, but mutated method chaining on function return values is not supported in Swift."},{"type":"text","text":"\n"},{"type":"text","text":"This Swift Package provides "},{"type":"reference","isActive":true,"overridingTitleInlineContent":[{"code":"pxr.GfMatrix4d.MakeTranslate()","type":"codeVoice"}],"overridingTitle":"pxr.GfMatrix4d.MakeTranslate()","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/GfMatrix4d\/MakeTranslate(_:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.GfMatrix4d.MakeRotate()"}],"overridingTitle":"pxr.GfMatrix4d.MakeRotate()","identifier":"doc:\/\/SwiftUsd\/document