ve-only in C++, which means they can’t be imported into Swift."},{"type":"text","text":"\n"},{"type":"text","text":"In some cases, a Swift wrapper type is provided in this Swift Package. For example, "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/Overlay\/UsdPrimTypeInfoWrapper","isActive":true},{"type":"text","text":". See "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WrappedTypes","isActive":true},{"type":"text","text":" for more information."}],"type":"paragraph"},{"anchor":"UsdPrimRange-and-for-loops","type":"heading","level":3,"text":"UsdPrimRange and for loops"},{"inlineContent":[{"code":"UsdPrimRange","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sequence","type":"codeVoice"},{"text":", enabling the use of for-loops and ","type":"text"},{"code":"Sequence","type":"codeVoice"},{"text":" methods like ","type":"text"},{"code":"filter","type":"codeVoice"},{"text":", ","type":"text"},{"code":"map","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"reduce","type":"codeVoice"}],"type":"paragraph"},{"code":["for prim in pxr.UsdPrim.PreAndPostVisit(stage.GetPseudoRoot()) {","    print(prim)","}","","let abstractPrims: [pxr.UsdPrim] = stage.Traverse().filter { $0.IsAbstract() }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"To access the ","type":"text"},{"type":"codeVoice","code":"iterator"},{"text":" of ","type":"text"},{"type":"codeVoice","code":"UsdPrimRange"},{"text":" in a for-loop, use ","type":"text"},{"type":"codeVoice","code":"UsdPrimRange.withIterator()"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["for (iter, prim) in pxr.UsdPrim.PreAndPostVisit(stage.GetPseudoRoot()).withIterator() {","    let path = String(prim.GetPath().GetAsString())","    print(path, iter.IsPostVisit())","    if path == \"\/Hello\" {","        iter.PruneChildren()","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"TfNotice","type":"heading","level":3,"text":"TfNotice"},{"inlineContent":[{"type":"text","text":"Swift code can register for "},{"type":"codeVoice","code":"TfNotice"},{"type":"text","text":" callbacks by using "},{"type":"reference","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-89t45","isActive":true,"overridingTitle":"pxr.TfNotice.Register"},{"type":"text","text":". Instead of creating a C++ class or struct that inherits from "},{"type":"codeVoice","code":"pxr::TfWeakBase"},{"type":"text","text":", call "},{"type":"reference","overridingTitleInlineContent":[{"code":"pxr.TfNotice.Register","type":"codeVoice"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-89t45","isActive":true,"overridingTitle":"pxr.TfNotice.Register"},{"type":"text","text":" and pass a closure:"}],"type":"paragraph"},{"code":["func registerWithRevoking(stage: pxr.UsdStage) {","    let key = pxr.TfNotice.Register(stage, pxr.UsdNotice.StageContentsChanged.self) { _ in","        print(\"Stage contents changed\")","    }","","    stage.SetStartTimeCode(5) \/\/ prints \"Stage contents changed\"","    stage.SetEndTimeCode(7) \/\/ prints \"Stage contents changed\"","    pxr.TfNotice.Revoke(key)","    stage.SetTimeCodesPerSecond(60) \/\/ no print","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"For more information, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfNotice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"GfMatrix4d-static-factory-methods","type":"heading","level":3,"text":"GfMatrix4d static factory methods"},{"inlineContent":[{"type":"text","text":"In C++, "},{"type":"codeVoice","code":"pxr::GfMatrix4d().SetTranslate()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"pxr::GfMatrix4d().SetRotate()"},{"type":"text","text":" are