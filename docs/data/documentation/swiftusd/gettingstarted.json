text":"","type":"text"},{"text":"\n","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Solution"}]},{"text":": In the Build Settings for your target, make sure that ","type":"text"},{"code":"Runpath Search Paths","type":"codeVoice"},{"text":" is set to ","type":"text"},{"code":"@executable_path\/Frameworks","type":"codeVoice"},{"text":". (","type":"text"},{"code":"LD_RUNPATH_SEARCH_PATHS=@executable_path\/Frameworks","type":"codeVoice"},{"text":" for xcconfig files.)","type":"text"},{"text":"\n","type":"text"},{"text":"Note: This should only affect command line executable targets.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"macOS apps with App Sandbox compiled in Release mode can’t find Hydra Render Delegate plugins when launched from Xcode","type":"text"},{"text":"\n","type":"text"},{"inlineContent":[{"text":"Solution","type":"text"}],"type":"strong"},{"text":": In the Run, Arguments, Environment Variables section of your Scheme, add ","type":"text"},{"code":"DYLD_FRAMEWORK_PATH=$CONFIGURATION_BUILD_DIR\/$FRAMEWORKS_FOLDER_PATH","type":"codeVoice"},{"text":" as a key-value pair","type":"text"}]}]}]}]}],"references":{"doc://SwiftUsd/documentation/SwiftUsd/CurrentLimitations":{"role":"article","kind":"article","abstract":[{"type":"text","text":"Learn about the current limitations of OpenUSD in Swift"}],"title":"Current Limitations","url":"\/documentation\/swiftusd\/currentlimitations","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/CurrentLimitations","type":"topic"},"doc://SwiftUsd/documentation/SwiftUsd/Capabilities":{"kind":"article","title":"Capabilities","url":"\/documentation\/swiftusd\/capabilities","type":"topic","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/Capabilities","abstract":[{"text":"Learn about the current capabilities of OpenUSD in Swift","type":"text"}],"role":"article"},"doc://SwiftUsd/documentation/SwiftUsd/DifferencesInSwift":{"kind":"article","title":"Differences in Sw