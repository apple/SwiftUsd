{"identifier":{"url":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfNotice","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Learn how to use the TfNotice notification subsystem in Swift"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftUsd\/documentation\/OpenUSD"]]},"metadata":{"modules":[{"name":"OpenUSD"}],"role":"article","roleHeading":"Article","title":"Working with TfNotice"},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DereferencingPointers","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/CreatingPointers","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/CheckingForValidity","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/UsingEditContexts","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfErrorMark","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WorkingWithTfDiagnosticFacilities","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/UsingLibWork","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ConvenientExtensions","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/TypeConversion"],"anchor":"New-symbol-documentation","title":"New symbol documentation","generated":true}],"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"OpenUSD includes a notification subsystem based on ","type":"text"},{"type":"codeVoice","code":"pxr::TfNotice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"pxr::TfNotice::Register"},{"text":" for use in C++. SwiftUsd exposes this system to Swift with minor modifications.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Like in C++, TfNotice registration in Swift comes in three main forms:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-1hdp4","type":"reference","isActive":true,"overridingTitle":"pxr.TfNotice.Register(_:_:)","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register(_:_:)"}]},{"type":"text","text":" to register for a particular notice type, regardless of sender"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:_:)-cz8x","isActive":true,"overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register(_:_:_:)"}],"overridingTitle":"pxr.TfNotice.Register(_:_:_:)"},{"type":"text","text":" to register for a particular notice type from a specific sender, without retrieving the sender in the notification callback"}]}]},{"content":[{"inlineContent":[{"overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register(_:_:_:)"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:_:)-4ev4","overridingTitle":"pxr.TfNotice.Register(_:_:_:)","type":"reference","isActive":true},{"type":"text","text":" to register for a particular notice type from a specific sender while retrieving the sender in the notification callback"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Example usage:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class StageWatcher {","    var stage: pxr.UsdStage","    var key: pxr.TfNotice.SwiftKey","","    init(stage: pxr.UsdStage) {","        self.stage = stage","","        key = pxr.TfNotice.Register(stage, pxr.UsdNotice.ObjectsChanged.self) { notice in","            print(\"Resynced: \\(notice.GetResyncedPaths())\")","            print(\"Changed info only: \\(notice.GetChangedInfoOnlyPaths())\")","        }","    }","    deinit {","        pxr.TfNotice.Revoke(key)","    }","}"]},{"type":"heading","level":2,"text":"Downcasting and inheritance","anchor":"Downcasting-and-inheritance"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When registering for a notice type, your notification callback may be called if notices that derive from the notice type you registered for are sent. To support conditional casting of "},{"type":"codeVoice","code":"TfNotice"},{"type":"text","text":" values in the notification callback, SwiftUsd provides "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/NoticeCaster","isActive":true},{"type":"text","text":" and three auxillary forms of "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-1hdp4","isActive":true,"overridingTitle":"pxr.TfNotice.Register()","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Register()"}]},{"type":"text","text":" that provide the "},{"type":"reference","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/NoticeCaster","isActive":true,"overridingTitle":"NoticeCaster","overridingTitleInlineContent":[{"code":"NoticeCaster","type":"codeVoice"}]},{"type":"text","text":" as a parameter to the notification callback:"}]},{"type":"codeListing","syntax":"swift","code":["func registerWithDowncasting() {","    pxr.TfNotice.Register(pxr.UsdNotice.StageNotice.self) { notice, caster in","        if let layerMutingChanged = caster(pxr.UsdNotice.LayerMutingChanged.self) {","            print(\"Muted: \\(layerMutingChanged.GetMutedLayers())\")","            print(\"Unmuted: \\(layerMutingChanged.GetUnmutedLayers())\")","        } else if let stageEditTargetChanged = caster(pxr.UsdNotice.StageEditTargetChanged.self) {","            print(\"Stage edit target changed: \\(stageEditTargetChanged.GetStage())\")","        }","    }","}"]},{"type":"heading","level":2,"text":"Cancellation","anchor":"Cancellation"},{"type":"paragraph","inlineContent":[{"text":"To cancel a notification callback, pass the return value from ","type":"text"},{"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:)-1hdp4","overridingTitleInlineContent":[{"code":"pxr.TfNotice.Register","type":"codeVoice"}],"overridingTitle":"pxr.TfNotice.Register","isActive":true,"type":"reference"},{"text":" to ","type":"text"},{"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/Revoke-31sr0","overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr.TfNotice.Revoke"}],"overridingTitle":"pxr.TfNotice.Revoke","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func registerWithRevoking(stage: pxr.UsdStage) {","    let key = pxr.TfNotice.Register(stage, pxr.UsdNotice.StageContentsChanged.self) { _ in","        print(\"Stage contents changed\")","    }","","    stage.SetStartTimeCode(5) \/\/ prints \"Stage contents changed\"","    stage.SetEndTimeCode(7) \/\/ prints \"Stage contents changed\"","    pxr.TfNotice.Revoke(key)","    stage.SetTimeCodesPerSecond(60) \/\/ no print","}"]},{"type":"heading","level":2,"text":"Swift-Cxx interoperability","anchor":"Swift-Cxx-interoperability"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The C++ and Swift versions of "},{"type":"reference","isActive":true,"overridingTitleInlineContent":[{"code":"pxr::TfNotice","type":"codeVoice"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice","overridingTitle":"pxr::TfNotice"},{"type":"text","text":" can interoperate with each other. The C++ return type "},{"type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"codeVoice","code":"pxr::TfNotice::Key"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Key","overridingTitle":"pxr::TfNotice::Key"},{"type":"text","text":" can be converted into the Swift return type "},{"type":"reference","isActive":true,"overridingTitleInlineContent":[{"code":"pxr::TfNotice::SwiftKey","type":"codeVoice"}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/SwiftKey","overridingTitle":"pxr::TfNotice::SwiftKey"},{"type":"text","text":", and both return types can be revoked from either language."}]},{"type":"codeListing","syntax":"c++","code":["pxr::TfNotice::Key registerForChanges(pxr::UsdStageWeakPtr);"]},{"type":"codeListing","syntax":"swift","code":["class KeyHolder {","    var keys = pxr.TfNotice.SwiftKeys()","","    init() {}","","    func callCppRegisterForChanges(stage: pxr.UsdStageWeakPtr) {","        let cppKey = registerForChanges(stage)","        let swiftKey = pxr.TfNotice.SwiftKey(cppKey)","        keys.push_back(swiftKey)","    }","","    func revokeAll() {","        pxr.TfNotice.Revoke(&keys)","    }","}"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftusd\/workingwithtfnotice"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/swiftusd\/workingwithtfnotice"]}],"references":{"doc://SwiftUsd/documentation/OpenUSD/C++/pxr/TfNotice/Register(_:_:_:)-cz8x":{"title":"Register(_:_:_:)","type":"topic","abstract":[{"type":"text","text":"Register a listener as being interested in a TfNotice from a particular sender."}],"identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD\/C++\/pxr\/TfNotice\/Register(_:_:_:)-cz8x","url":"\/documentation\/openusd\/c++\/pxr\/tfnotice\/register(_:_:_:)-cz8x","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"Register"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Notice"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Sender"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:So021pxrInternal_v0_26_8__A10Reserved__O8TfNoticeV7OpenUSDE8RegisteryAD8SwiftKeyVq__xmyxYbctSo0J3UsdOAEE0eF8ProtocolRzSo7OverlayOAEE01_e8WeakBaseM0R_9_SelfTypeQy_Rs_r0_lFZ6SenderL_q_mfp","text":"Sender"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:So021pxrInternal_v0_26_8__A10Reserved__O8TfNot