{"metadata":{"title":"Writing and Using OpenUSD Plugins","roleHeading":"Article","role":"article","modules":[{"name":"OpenUSD"}]},"sections":[],"identifier":{"url":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/WritingAndUsingOpenUSDPlugins","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftusd\/writingandusingopenusdplugins"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/swiftusd\/writingandusingopenusdplugins"],"traits":[{"interfaceLanguage":"occ"}]}],"seeAlsoSections":[{"generated":true,"title":"Technical details","identifiers":["doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/SwiftSubclassCxx","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DetectingOpenUSDFeatureFlags","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/BuildingLocally","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ChangesToOpenUSD"],"anchor":"Technical-details"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenUSD has a plugin system for extending its core capabilities, such as adding support for new image or Sdf file formats or adding new Hydra Render Delegates. With SwiftUsd, you can write plugins in either C++ or Swift, and use them in both SwiftUsd-based apps and vanilla OpenUSD runtimes (e.g. "},{"type":"codeVoice","code":"usdview"},{"type":"text","text":" and "},{"type":"codeVoice","code":"usdrecord"},{"type":"text","text":" from a vanilla install of OpenUSD)."}]},{"type":"heading","text":"Writing plugins in C++ with SwiftUsd","level":2,"anchor":"Writing-plugins-in-C++-with-SwiftUsd"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"isActive":true,"identifier":"https:\/\/github.com\/apple\/SwiftUsd\/tree\/main\/Examples\/Plugins\/HioImage\/hioPpm_Cxx","type":"reference"},{"type":"text","text":" for an example plugin."}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Create a Swift Package for your plugin.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Within the ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" package manifest, add a ","type":"text"},{"code":".library","type":"codeVoice"},{"text":" product that depends on your C++ target or targets.","type":"text"},{"text":"\n","type":"text"},{"text":"For example:","type":"text"}]}]}]},{"type":"codeListing","syntax":"swift","code":["products: [.library(name: \"hioPpm\", targets: [\"hioPpm\"]),],"]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"In your package manifest, add these lines to the definition of your C++ target:","type":"text"}],"type":"paragraph"}]}],"start":3},{"type":"codeListing","syntax":"swift","code":["resources: [.copy(\"plugInfo.json\")],","plugins: [.plugin(name: \"generate-plug-info-json\", package: \"SwiftUsd\")],"]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a "},{"code":"plugInfo.json","type":"codeVoice"},{"type":"text","text":" file to your C++ target."},{"type":"text","text":"\n"},{"type":"text","text":"Make sure to use the following key-value pairs within your plugin instead of hard-coding in specific values. This will ensure that the correct values are inserted into your "},{"code":"plugInfo.json","type":"codeVoice"},{"type":"text","text":" file at compile time."}]}]}],"start":4},{"type":"codeListing","syntax":"json","code":["\"LibraryPath\": \"@PLUG_INFO_LIBRARY_PATH@\",","\"ResourcePath\": \"@PLUG_INFO_RESOURCE_PATH@\",","\"Root\": \"@PLUG_INFO_ROOT@\","]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Subclass one or more OpenUSD types as needed for your plugin.","type":"text"},{"text":"\n","type":"text"},{"text":"For example, to write a PPM HioImage plugin, you might write:","type":"text"}]}]}],"start":5},{"type":"codeListing","syntax":"cpp","code":["class HioPpm_Image final: public pxr::HioImage { ","   ..."," };"]},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"The type name in the "},{"type":"codeVoice","code":"Types"},{"type":"text","text":" object in your "},{"type":"codeVoice","code":"plugInfo.json"},{"type":"text","text":" file must match the name of your C++ plugin subclass."}],"type":"paragraph"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Within a "},{"type":"codeVoice","code":".cpp"},{"type":"text","text":" file, make sure to use "},{"type":"codeVoice","code":"TF_REGISTRY_FUNCTION"},{"type":"text","text":" to let the OpenUSD runtime know about your plugin subclass."},{"type":"text","text":"\n"},{"type":"text","text":"For example:"}]}]}],"start":6},{"type":"codeListing","syntax":"cpp","code":["#include \"pxr\/base\/tf\/type.h\"","#include \"pxr\/base\/tf\/registryManager.h\"","#include \"pxr\/imaging\/hio\/image.h\"","","PXR_NAMESPACE_OPEN_SCOPE","TF_REGISTRY_FUNCTION(TfType) {","    TfType t = pxr::TfType::Define<HioPpm_Image, pxr::TfType::Bases<pxr::HioImage>>();","    t.SetFactory<pxr::HioImageFactory<HioPpm_Image>>();","}","PXR_NAMESPACE_CLOSE_SCOPE"]},{"type":"heading","text":"Writing plugins in Swift with SwiftUsd","level":2,"anchor":"Writing-plugins-in-Swift-with-SwiftUsd"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"https:\/\/github.com\/apple\/SwiftUsd\/tree\/main\/Examples\/Plugins\/HioImage\/hioPpm_Swift","isActive":true},{"type":"text","text":" for an example plugin."}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"Currently, only HioImage plugins can be written in Swift.","type":"text"}],"type":"paragraph"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Create a Swift Package for your plugin"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Within the ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" package manifest, add a ","type":"text"},{"code":".library","type":"codeVoice"},{"text":" product that depends on your Swift target or targets.","type":"text"},{"text":"\n","type":"text"},{"text":"For example:","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["products: [.library(name: \"hioPpm\", targets: [\"hioPpm\"]),],"]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In your package manifest, add these lines to the definition of your Swift target:"}]}]}],"start":3},{"type":"codeListing","syntax":"swift","code":["resources: [.copy(\"plugInfo.json\")],","swiftSettings: [.interoperabilityMode(.Cxx)],","plugins: [.plugin(name: \"generate-plug-info-json\", package: \"SwiftUsd\")],"]},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"text":"On Swift 6.1-6.2, you also need to add ","type":"text"},{"code":".enableExperimentalFeature(\"SymbolLinkageMarkers\")","type":"codeVoice"},{"text":" to the ","type":"text"},{"code":"swiftSettings","type":"codeVoice"},{"text":" array.","type":"text"}],"type":"paragraph"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a "},{"type":"codeVoice","code":"plugInfo.json"},{"type":"text","text":" file to your target."},{"type":"text","text":" "},{"type":"text","text":"Make sure to use the following key-value pairs within your plugin instead of hard-coding in specific values. This will ensure that the correct values are inserted into your "},{"type":"codeVoice","code":"plugInfo.json"},{"type":"text","text":" file at compile time."}]}]}],"start":4},{"type":"codeListing","syntax":"json","code":["\"LibraryPath\": \"@PLUG_INFO_LIBRARY_PATH@\",","\"ResourcePath\": \"@PLUG_INFO_RESOURCE_PATH@\",","\"Root\": \"@PLUG_INFO_ROOT@\","]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Subclass one or more OpenUSD types as needed for your plugin using "},{"code":"Overlay.FooSubclass","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":"\n"},{"type":"text","text":"For example:"}]}]}],"start":5},{"type":"codeListing","syntax":"swift","code":["final class HioPpm_Image: Overlay.HioImageSubclass {","   ....","}"]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Not all OpenUSD types can be subclassed in Swift. See "},{"identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/SwiftSubclassCxx","isActive":true,"type":"reference"},{"type":"text","text":" for the complete list."}],"type":"paragraph"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Apply "},{"code":"@SWIFTUSD_PLUGIN","type":"codeVoice"},{"type":"text","text":" to your plugin entry point. For example:"}],"type":"paragraph"}]}],"start":6},{"type":"codeListing","syntax":"swift","code":["@SWIFTUSD_PLUGIN","final class HioPpm_Image: Overlay.HioImageSubclass {","    ...","}"]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"You only need to use the macro once per plugin, on the plugin entry point, not on every Swift subclass of an OpenUSD type. The name of the Swift class you apply the macro to must match the value in the ","type":"text"},{"code":"Types","type":"codeVoice"},{"text":" object in your ","type":"text"},{"code":"plugInfo.json","type":"codeVoice"},{"text":" file.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Using plugins within a SwiftUsd-based application","level":2,"anchor":"Using-plugins-within-a-SwiftUsd-based-application"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the SwiftUsd-based plugin you want to use as a remote or local package dependency to your app. The OpenUSD runtime will automatically discover and use the plugin when needed."}]}]}]},{"type":"heading","text":"Using plugins within a vanilla OpenUSD-based application","level":2,"anchor":"Using-plugins-within-a-vanilla-OpenUSD-based-application"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clone the SwiftUsd-based plugin you want to use."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run the following commands:","type":"text"}]}]}]},{"type":"codeListing","syntax":"zsh","code":["cd \/path\/to\/cloned-swiftusd-plugin","swift build","swift package build-vanilla-openusd-plugin"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"swift build"},{"type":"text","text":" command builds the package like normal, and the "},{"type":"codeVoice","code":"swift package build-vanilla-openusd-plugin"},{"type":"text","text":" invokes a SwiftUsd-provided custom build command that converts the output from "},{"type":"codeVoice","code":"swift build"},{"type":"text","text":" into an OpenUSD plugin."}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the "},{"type":"codeVoice","code":"PXR_PLUGINPATH_NAME"},{"type":"text","text":" environment variable to include the path to the plugin produced by "},{"type":"codeVoice","code":"swift package build-vanilla-openusd-plugin"},{"type":"text","text":". For example:"}]}]}],"start":3},{"type":"codeListing","syntax":null,"code":["export PXR_PLUGINPATH_NAME=\"\/Users\/maddyadams\/SwiftUsd\/Examples\/Plugins\/HioImage\/hioPpm_Swift\/.build\/plugins\/build-vanilla-openusd-plugin\/outputs\/hioPpm.usdplugin:$PXR_PLUGINPATH_NAME\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then, use a command like "},{"code":"usdview","type":"codeVoice"},{"type":"text","text":" or "},{"code":"usdrecord","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":".usdplugin"},{"type":"text","text":" directory produced by "},{"type":"codeVoice","code":"swift package build-vanilla-openusd-plugin"},{"type":"text","text":" is fully relocatable, so you can move it to another directory after compiling."}],"type":"paragraph"}]},{"type":"heading","text":"Technical details","level":2,"anchor":"Technical-details"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After you add "},{"code":"plugins: [.plugin(name: \"generate-plug-info-json\", package: \"SwiftUsd\")],","type":"codeVoice"},{"type":"text","text":" to a target in your Swift Package manifest, the build system will automatically invoke the Swift Package Manager plugin "},{"code":"generate-plug-info-json","type":"codeVoice"},{"type":"text","text":" provided by SwiftUsd when building that target. (Note that Swift Package Manager plugins are completely unrelated to OpenUSD plugins.)"},{"type":"text","text":"\n"},{"code":"generate-plug-info-json","type":"codeVoice"},{"type":"text","text":" produces three modified copies of your "},{"code":"plugInfo.json","type":"codeVoice"},{"type":"text","text":" file: "},{"code":"plugInfo_macOS.json","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"plugInfo_iOS.json"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"plugInfo_vanilla.json"},{"text":". SwiftUsd-based applications will automatically use ","type":"text"},{"type":"codeVoice","code":"plugInfo_macOS.json"},{"text":" in macOS apps and ","type":"text"},{"type":"codeVoice","code":"plugInfo_iOS.json"},{"text":" in iOS\/visionOS apps, ignoring the other files. After using ","type":"text"},{"type":"codeVoice","code":"swift package build-vanilla-openusd-plugin"},{"text":" on a plugin, vanilla OpenUSD runtimes will automatically use ","type":"text"},{"type":"codeVoice","code":"plugInfo_vanilla.json"},{"text":", ignoring the other files.","type":"text"},{"text":" ","type":"text"},{"text":"The different files are required because macOS, iOS, and vanilla OpenUSD plugins use different bundle structures. When you use the ","type":"text"},{"type":"codeVoice","code":"@PLUG_INFO_FOO@"},{"text":" values in your ","type":"text"},{"type":"codeVoice","code":"plugInfo.json"},{"text":" file instead of hard-coding values, ","type":"text"},{"type":"codeVoice","code":"generate-plug-info-json"},{"text":" automatically fills them in with the right values for the intended target architecture\/use case.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"swift package build-vanilla-openusd-plugin","type":"codeVoice"},{"type":"text","text":" invokes the Swift Package Manager plugin "},{"code":"build-vanilla-openusd-plugin","type":"codeVoice"},{"type":"text","text":" provided by SwiftUsd. (Note that Swift Package Manager plugins are completely unrelated to OpenUSD plugins.)"},{"type":"text","text":"\n"},{"code":"build-vanilla-openusd-plugin","type":"codeVoice"},{"type":"text","text":" expects that you’ve already run "},{"code":"swift build","type":"codeVoice"},{"type":"text","text":" to compile your code. It traverses the build directory to find and link together object files produced by your targets. It also weak-links the OpenUSD frameworks provided by SwiftUsd. This means that your dylib may still work if the host application wasn’t built with certain feature flags (e.g. Alembic), but it also means that your dylib may crash the host application if it tries to use missing symbols without checking for their existence at runtime. Finally, "},{"code":"build-vanilla-openusd-plugin","type":"codeVoice"},{"type":"text","text":" uses "},{"code":"install_name_tool","type":"codeVoice"},{"type":"text","text":" to change the "},{"code":"LC_LOAD_DYLIB","type":"codeVoice"},{"type":"text","text":" commands to the form used by vanilla OpenUSD installs."}]}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftUsd\/documentation\/OpenUSD"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Learn how to write and use OpenUSD plugins written in Swift or C++","type":"text"}],"references":{"doc://SwiftUsd/documentation/SwiftUsd/SwiftSubclassCxx":{"url":"\/documentation\/swiftusd\/swiftsubclasscxx","role":"article","type":"topic","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/SwiftSubclassCxx","kind":"article","title":"OpenUSD types that can be subclassed in Swift","abstract":[]},"https://github.com/apple/SwiftUsd/tree/main/Examples/Plugins/HioImage/hioPpm_Cxx":{"type":"link","title":"SwiftUsd\/Examples\/Plugins\/HioImage\/hioPpm_Cxx","identifier":"https:\/\/github.com\/apple\/SwiftUsd\/tree\/main\/Examples\/Plugins\/HioImage\/hioPpm_Cxx","titleInlineContent":[{"type":"text","text":"SwiftUsd\/Examples\/Plugins\/HioImage\/hioPpm_Cxx"}],"url":"https:\/\/github.com\/apple\/SwiftUsd\/tree\/main\/Examples\/Plugins\/HioImage\/hioPpm_Cxx"},"doc://SwiftUsd/documentation/SwiftUsd/ChangesToOpenUSD":{"url":"\/documentation\/swiftusd\/changestoopenusd","title":"Changes to OpenUSD","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ChangesToOpenUSD","abstract":[{"type":"text","text":"Learn about the changes this Swift Package makes to OpenUSD"}]},"doc://SwiftUsd/documentation/SwiftUsd/BuildingLocally":{"role":"article","url":"\/documentation\/swiftusd\/buildinglocally","type":"topic","kind":"article","title":"Building locally","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/BuildingLocally","abstract":[{"type":"text","text":"Learn how to use SwiftUsd with local\/existing OpenUSD binaries"}]},"doc://SwiftUsd/documentation/OpenUSD":{"abstract":[],"type":"topic","title":"OpenUSD","kind":"symbol","url":"\/documentation\/openusd","role":"collection","identifier":"doc:\/\/SwiftUsd\/documentation\/OpenUSD"},"https://github.com/apple/SwiftUsd/tree/main/Examples/Plugins/HioImage/hioPpm_Swift":{"titleInlineContent":[{"text":"SwiftUsd\/Examples\/Plugins\/HioImage\/hioPpm_Swift","type":"text"}],"identifier":"https:\/\/github.com\/apple\/SwiftUsd\/tree\/main\/Examples\/Plugins\/HioImage\/hioPpm_Swift","title":"SwiftUsd\/Examples\/Plugins\/HioImage\/hioPpm_Swift","type":"link","url":"https:\/\/github.com\/apple\/SwiftUsd\/tree\/main\/Examples\/Plugins\/HioImage\/hioPpm_Swift"},"doc://SwiftUsd/documentation/SwiftUsd/DetectingOpenUSDFeatureFlags":{"title":"Detecting OpenUSD feature flags","url":"\/documentation\/swiftusd\/detectingopenusdfeatureflags","type":"topic","role":"article","identifier":"doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DetectingOpenUSDFeatureFlags","kind":"article","abstract":[{"text":"Learn how to detect OpenUSD feature flags","type":"text"}]}},"variantOverrides":[{"patch":[{"value":"occ","path":"\/identifier\/interfaceLanguage","op":"replace"},{"value":null,"path":"\/topicSections","op":"add"},{"value":[{"identifiers":["doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/SwiftSubclassCxx","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/DetectingOpenUSDFeatureFlags","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/BuildingLocally","doc:\/\/SwiftUsd\/documentation\/SwiftUsd\/ChangesToOpenUSD"],"generated":true,"anchor":"Technical-details","title":"Technical details"}],"path":"\/seeAlsoSections","op":"replace"}],"traits":[{"interfaceLanguage":"occ"}]}]}